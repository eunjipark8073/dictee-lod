    {
      "@id": "dict:concept/postcolonial-feminism",
      "@type": "Type",
      "identified_by": [
        {
          "type": "Name",
          "content": "Postcolonial Feminism",
          "language": "en"
        },
        {
          "type": "Name",
          "content": "탈식민 페미니즘",
          "language": "ko"
        }
      ],
      "dictrel:entityType": "Concept",
      "dictrel:documentedIn": [
        "dictee"
      ],
      "dictrel:mappingStatus": "closeMatch",
      "skos:closeMatch": [
        {
          "id": "https://www.wikidata.org/wiki/Q7234128"
        },
        {
          "id": "https://homosaurus.org/v3/homoit0003616"
        }
      ],
      "referred_to_by": [
        {
          "type": "LinguisticObject",
          "content": "A critical framework that examines the intersection of colonialism, gender, and knowledge production. Associated with theorists including Spivak and Mohanty, it critiques Western feminist frameworks for their complicity in imperial structures.",
          "classified_as": "description"
        },
        {
          "type": "LinguisticObject",
          "content": "Critique of Western imperialism's subjugation of subjects through language and knowledge systems. Mohanty (1984) + Spivak (1988). Upper-level framework for entire Dictée analysis — all other theoretical concepts operate within this frame.",
          "classified_as": "scope_note"
        }
      ],
      "dict:evidenceType": "Direct Term",
      "dict:chapter": [
        "ALL"
      ]
    },
    {
      "@id": "dict:concept/translational-violence",
      "@type": "Type",
      "identified_by": [
        {
          "type": "Name",
          "content": "Translational Violence",
          "language": "en"
        },
        {
          "type": "Name",
          "content": "번역 폭력",
          "language": "ko"
        }
      ],
      "dictrel:entityType": "Concept",
      "dictrel:documentedIn": [
        "dictee"
      ],
      "dictrel:mappingStatus": "noExternalAuthority",
      "referred_to_by": [
        {
          "type": "LinguisticObject",
          "content": "Epistemic violence enacted through forced linguistic assimilation across generations. Draws on Spivak's concept of epistemic violence and Fanon's analysis of colonial internalization, applied to the intergenerational linguistic displacement experienced by Cha and her mother under colonial and diasporic conditions.",
          "classified_as": "description"
        },
        {
          "type": "LinguisticObject",
          "content": "Intergenerational epistemic violence through forced linguistic assimilation. Mother (Huh Hyung Soon): Japanese enforced → Korean forbidden → Chinese ambient (Manchukuo). Cha: Korean suppressed → English enforced → French acquired (Sacred Heart). Spivak's epistemic violence materialized across two generations. Synthesis of Spivak (1988) + Fanon, Black Skin White Masks (1952) + Cha's text.",
          "classified_as": "scope_note"
        }
      ],
      "dict:evidenceType": "Synthesis",
      "dict:chapter": [
        "CALLIOPE",
        "URANIA"
      ],
      "dict:pageReference": "pp.35, 45",
      "dict:prefigures": [
        {
          "id": "dict:concept/untranslatability",
          "dictrel:documentedIn": [
            "dictee"
          ],
          "dict:note": "Translational violence creates the conditions for untranslatability."
        }
      ],
      "dict:silences": [
        {
          "id": "dict:person/huh-hyungsoon",
          "dictrel:documentedIn": [
            "dictee"
          ],
          "dict:pageRef": "CALLIOPE pp.45-59",
          "dict:note": "Colonial language violence silences Huh Hyungsoon's linguistic subjectivity."
        },
        {
          "id": "dict:person/diseuse",
          "dictrel:documentedIn": [
            "dictee"
          ],
          "dict:pageRef": "DISEUSE pp.3-4",
          "dict:note": "Translational violence constitutes the very conditions of Diseuse's speech."
        }
      ],
