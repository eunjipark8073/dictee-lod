        {
          "type": "LinguisticObject",
          "content": "Hortense Spillers, Black feminist theorist. Best known for 'Mama's Baby, Papa's Maybe: An American Grammar Book' (1987), which theorizes the distinction between flesh and body under conditions of slavery and colonial violence.",
          "classified_as": "description"
        },
        {
          "type": "LinguisticObject",
          "content": "'Mama's Baby, Papa's Maybe: An American Grammar Book' (1987). flesh/body distinction: enslaved women as 'female but not woman,' reduced to 'zero degree of social conceptualisation.' Ungendering concept. Primary theoretical source for dict:concept/ungendering — applied to URANIA's blood/ink transformation (pp.64-65).",
          "classified_as": "scope_note"
        }
      ],
      "dict:evidenceType": "Scholarly",
