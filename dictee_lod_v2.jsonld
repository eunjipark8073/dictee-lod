    {
      "@id": "dict:object/punctuation",
      "@type": "Type",
      "identified_by": [
        {
          "type": "Name",
          "content": "Punctuation as Text",
          "language": "en"
        },
        {
          "type": "Name",
          "content": "문장부호의 텍스트화",
          "language": "ko"
        }
      ],
      "dictrel:entityType": "Object",
      "dictrel:documentedIn": [
        "dictee"
      ],
      "dictrel:mappingStatus": "noExternalAuthority",
      "referred_to_by": [
        {
          "type": "LinguisticObject",
          "content": "A dictation exercise in which punctuation marks — period, comma, open quotation marks — are written out as words rather than rendered as symbols. Reproduced in the text as a document of language's regulatory function made visible through instruction.",
          "classified_as": "description"
        },
        {
          "type": "LinguisticObject",
          "content": "'Period', 'Comma', 'Open quotation marks' written as words rather than symbols in dictation exercise. Language's regulatory infrastructure made visible. Diseuse 'would take on their punctuation... become, herself, demarcations.' (p.4). Connects to dict:rel/embodiesPunctuation.",
          "classified_as": "scope_note"
        }
      ],
