        {
          "type": "LinguisticObject",
          "content": "Gayatri Chakravorty Spivak, postcolonial theorist. Best known for 'Can the Subaltern Speak?' (1988), which examines the representational limits of Western intellectual frameworks in relation to colonized subjects.",
          "classified_as": "description"
        },
        {
          "type": "LinguisticObject",
          "content": "'Can the Subaltern Speak?' (1988). Representational crisis: Vertreten (political proxy) vs Darstellen (portrayal). Framework for Diseuse's mediation and translational-violence concept.",
          "classified_as": "scope_note"
        }
      ],
      "dict:evidenceType": "Scholarly",
