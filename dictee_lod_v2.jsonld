      "referred_to_by": [
        {
          "type": "LinguisticObject",
          "content": "María Lugones, decolonial feminist philosopher. Key works include 'Coloniality of Gender' (2007) and 'Toward a Decolonial Feminism' (2010), which argue that gender itself is a colonial imposition and theorize active subjectivity within decolonial practice.",
          "classified_as": "description"
        },
        {
          "type": "LinguisticObject",
          "content": "'Coloniality of Gender' (2007); 'Toward a Decolonial Feminism' (2010). Gender itself as colonial introduction. Fractured Locus: active subjectivity between colonial designation and communal memory. Framework for shamanic mediation and cyclical time concepts.",
          "classified_as": "scope_note"
        }
      ],
      "dict:evidenceType": "Scholarly",
      "dict:pageReference": "Theoretical framework",
      "dict:critiques": [
