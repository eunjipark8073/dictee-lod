      "referred_to_by": [
        {
          "type": "LinguisticObject",
          "content": "Acupuncture meridian chart from the Chinese medical tradition, included in the text as a visual document. Presents speech and emotion as physiological processes located in specific organs of the body.",
          "classified_as": "description"
        },
        {
          "type": "LinguisticObject",
          "content": "Ming dynasty (1341) Shisijing Fahui / Han dynasty Nanjing. Speech as physiological process. Tunstall: 'grief is located in the lungs' in Eastern medicine. Paired with vocal anatomy diagram — two knowledge systems approaching the same question.",
          "classified_as": "scope_note"
        }
      ],
